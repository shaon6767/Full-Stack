<%- include('partials/header', { title: 'Home' }) %>

<main class="mx-auto flex max-w-6xl flex-col items-center justify-center px-6 py-20 text-center">
  <div class="w-full max-w-3xl rounded-3xl border border-slate-200 bg-white/90 p-10 shadow-xl backdrop-blur-sm">
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-emerald-600">Welcome</p>
    <h2 class="mt-6 text-4xl font-bold text-slate-900 md:text-5xl">Welcome to Airbnb</h2>
    <p class="mt-4 text-lg text-slate-600">
      Find unique homes, welcome new guests, and grow your hosting journey with ease.
    </p>

    <div class="mt-8 flex items-center justify-center gap-4">
      <a
        href="/host/add-home"
        class="inline-flex items-center justify-center rounded-xl bg-rose-500 px-6 py-3 text-base font-semibold text-white shadow-lg shadow-rose-200 transition hover:bg-rose-600 focus:outline-none focus:ring-4 focus:ring-rose-200"
      >
        Add Home
      </a>
      <a
        href="/homes"
        class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"
      >
        See Homes
      </a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
